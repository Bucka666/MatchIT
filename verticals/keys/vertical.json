  "categories": {
    "CYLINDER":        {"label": "Single-sided",    "show": ["front_grooves","back_grooves","pin_count"]},
    "DOUBLE_SIDED":    {"label": "Double-sided",    "show": ["groove_side","front_grooves","back_grooves","pin_count"]},
    "MORTICE":         {"label": "Mortice (Lever)",  "show": ["groove_side","flag_profile","bow_shape","front_grooves","back_grooves","mortice_gauge"]},
    "MORTICE_PIN":     {"label": "Mortice Pin",      "show": ["groove_side","flag_profile","bow_shape","front_grooves","back_grooves","mortice_gauge"]},
    "MORTICE_PIPE":    {"label": "Mortice Pipe",     "show": ["groove_side","flag_profile","bow_shape","front_grooves","back_grooves","mortice_gauge"]},
    "MORTICE_PRECUT":  {"label": "Mortice Pre-Cut",  "show": ["groove_side","flag_profile","bow_shape","front_grooves","back_grooves","mortice_gauge"]},
    "DOUBLE_BIT_PIN":  {"label": "Double Bit Pin",   "show": ["groove_side","flag_profile","bow_shape","front_grooves","back_grooves","mortice_gauge"]},
    "DOUBLE_BIT_PIPE": {"label": "Double Bit Pipe",  "show": ["groove_side","flag_profile","bow_shape","front_grooves","back_grooves","mortice_gauge"]},
    "DIMPLE":          {"label": "Dimple / Cavity",  "show": ["groove_side","dimple_track","dimple_cuts"]}
  },

  "profile_fields": [
    {
      "id": "front_grooves",
      "label": "Front grooves",
      "type": "int_range",
      "min": 0, "max": 6,
      "default": -1,
      "penalty": 0.970,
      "match_rule": "exact"
    },
    {
      "id": "back_grooves",
      "label": "Back grooves",
      "type": "int_range",
      "min": 0, "max": 6,
      "default": -1,
      "penalty": 0.970,
      "match_rule": "exact"
    },
    {
      "id": "pin_count",
      "label": "Pins / Cuts Count",
      "type": "int_range",
      "min": 2, "max": 10,
      "default": -1,
      "penalty": 0.975,
      "match_rule": "exact"
    },
    {
      "id": "groove_side",
      "label": "Groove side",
      "type": "select",
      "options": [["","Unknown"],["LEFT","Left"],["RIGHT","Right"],["BOTH","Both"],["NONE","None"]],
      "default": "",
      "penalty": 0.970,
      "match_rule": "exact"
    },
    {
      "id": "flag_profile",
      "label": "Flag profile",
      "type": "select",
      "options": [["","Unknown"],["FLAT","Flat"],["STEPPED","Stepped"],["GROOVED","Grooved"],["RAISED_RIDGE","Raised Ridge"]],
      "default": "",
      "penalty": 0.965,
      "match_rule": "exact"
    },
    {
      "id": "bow_shape",
      "label": "Bow shape",
      "type": "select",
      "options": [["","Unknown"],["ROUND","Round"],["OVAL","Oval"],["SQUARE","Square"],["UNIQUE","Unique / Other"]],
      "default": "",
      "penalty": 0.960,
      "match_rule": "exact"
    },
    {
      "id": "mortice_gauge",
      "label": "Gauge (thickness)",
      "type": "float_select",
      "values_by_category": {
        "MORTICE":         [1,2,2.5,3,3.5,4,4.5,5,5.5,6,6.5,7,7.5,8],
        "MORTICE_PIN":     [1,2,2.5,3,3.5,4,4.5,5,5.5,6,6.5,7,7.5,8],
        "MORTICE_PRECUT":  [1,2,2.5,3,3.5,4,4.5,5,5.5,6,6.5,7,7.5,8],
