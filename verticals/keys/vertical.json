        "DOUBLE_BIT_PIN":  [1,2,2.5,3,3.5,4,4.5,5,5.5,6,6.5,7,7.5,8],
        "DOUBLE_BIT_PIPE": [5,6,7,8,9,10,11,12]
      },
      "default": -1,
      "penalty": 0.950,
      "match_rule": "exact_float"
    },
    {
      "id": "dimple_track",
      "label": "Track type",
      "type": "select",
      "options": [["","Unknown"],["SINGLE_TRACK","Single Track"],["DOUBLE_TRACK","Double Track"]],
      "default": "",
      "penalty": 0.955,
      "match_rule": "exact"
    },
    {
      "id": "dimple_cuts",
      "label": "Dimple cut count",
      "type": "int_range",
      "min": 5, "max": 10,
      "default": -1,
      "penalty": 0.975,
      "match_rule": "exact"
    }
