  "cross_reference_sources": {
    "_note": "External price/listing sources for cross-referencing",
    "tcgplayer": {
      "label": "TCGPlayer",
      "url_template": "https://www.tcgplayer.com/product/{tcgplayer_id}",
      "field": "tcgplayer_id"
    },
    "cardmarket": {
      "label": "Cardmarket",
      "url_template": "https://www.cardmarket.com/en/Pokemon/Products/Singles/{set_slug}/{card_slug}",
      "field": "cardmarket_id"
    },
    "pokemontcg_io": {
      "label": "pokemontcg.io",
      "url_template": "https://pokemontcg.io/card/{api_id}",
      "field": "api_id"
    }
  },

  "api_sources": {
    "pokemon": {
      "base_url": "https://api.pokemontcg.io/v2",
      "rate_limit_per_sec": 3,
      "image_field": "images.large",
      "id_field": "id"
    }
  },

