  "ui_text": {
    "how_to_title": "How to identify your card",
    "step1_text": "If you have a <strong>card name or set number</strong>, enter it below — or search by <strong>set name</strong>",
    "step1_placeholder": "e.g. Charizard, base1-4, Sword & Shield…",
    "step2_text": "Or <strong>upload / take a photo</strong> of the card front — select the card game and fill in details below for better results",
    "progress_subtitle": "Analysing your card against the database…",
    "guide_tips": [
      "Fill most of the frame with the <strong>card front</strong> (crop out background).",
      "Use good lighting — avoid glare on holos and foils.",
      "Keep the card flat and straight — avoid angles or warping.",
      "Select the card game above if known — this dramatically narrows the search."
    ],
    "feedback_correct_prompt": "Was the correct card in these results?",
    "feedback_notfound_prompt": "Which card was it? (enter set number or leave blank if unknown)",
    "feedback_sku_placeholder": "e.g. base1-4, swsh1-25",
    "db_sync_title": "CardsDB Sync",
    "db_sync_desc": "Pulls new card images from the configured API sources into MatchIT's local DB.",
    "db_sync_button": "Sync from API",
    "db_sync_confirm": "Fetch new card images from pokemontcg.io into the local database?"
  },

  "require_two_images": false,
  "style_detection_enabled": false,
  "ras_images_enabled": false,
  "multi_crop": false,
  "suppress_bg": false,
