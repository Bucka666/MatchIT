{% extends "base.html" %}
{% block body %}
<div class="mi-card upgrade-page">

  <div style="margin-bottom:16px;">
    <button type="button" onclick="history.back()" class="mi-back-btn">
      ← Back
    </button>
  </div>

  <div style="text-align:center;margin-bottom:32px;">
    <div style="font-size:2.5rem;margin-bottom:12px;">⚡</div>
    <h1 class="mi-h1" style="font-size:1.8rem;margin-bottom:8px;">Upgrade to GrailSweep Pro</h1>
    <p style="color:var(--mi-muted,#aaa);font-size:0.95rem;max-width:480px;margin:0 auto;">
      Unlock generous monthly scanning, collection tracking, AI condition grading and more.
      Monthly subscribers get 10 deep grades/month — upgrade to Annual for 20,
      or grab Founder Yearly while it lasts.
    </p>
    <div id="scanWarning" style="display:none;margin-top:16px;background:rgba(255,45,111,0.1);border:1px solid rgba(255,45,111,0.3);border-radius:10px;padding:12px 20px;color:#ff2d6f;font-size:0.88rem;">
      🚫 You've used all 25 free scans this month. Upgrade to Pro for 1,000+ scans/month, or wait until next month.
    </div>
  </div>

  <!-- Pricing cards -->
  <div class="upgrade-tiers">

    <!-- Free tier -->
    <div class="upgrade-tier upgrade-tier--free">
      <div class="upgrade-tier-name">Free</div>
      <div class="upgrade-tier-price">£0</div>
      <div class="upgrade-tier-period">forever</div>
      <ul class="upgrade-features">
        <li class="upgrade-feature">✅ 25 card scans per month</li>
        <li class="upgrade-feature">✅ AI card identification (Pokémon, MTG, Yu-Gi-Oh)</li>
        <li class="upgrade-feature">✅ Live GBP price reference</li>
        <li class="upgrade-feature">✅ Auto condition grade</li>
        <li class="upgrade-feature upgrade-feature--no">❌ Only 25 scans/month</li>
        <li class="upgrade-feature upgrade-feature--no">❌ Collection manager &amp; more</li>
      </ul>
      {% if not ssr_is_premium %}<div class="upgrade-tier-cta upgrade-tier-cta--free">Current Plan</div>{% endif %}
    </div>

    <!-- Monthly tier -->
    <div class="upgrade-tier upgrade-tier--monthly">
      <div class="upgrade-tier-name">Pro Monthly</div>
      <div class="upgrade-tier-price">£3.99</div>
      <div class="upgrade-tier-period">per month</div>
      <ul class="upgrade-features">
        <li class="upgrade-feature">✅ 1,000 scans/month</li>
        <li class="upgrade-feature">✅ Everything in Free</li>
        <li class="upgrade-feature">✅ Collection manager + Excel/CSV</li>
        <li class="upgrade-feature">✅ Price alerts + live scanner</li>
        <li class="upgrade-feature">✅ Cancel anytime</li>
      </ul>
      {% if ssr_is_premium and ssr_sub and ssr_sub.tier in ['monthly', 'legacy'] %}
        <div class="upgrade-tier-cta upgrade-tier-cta--free">✓ Current Plan{% if ssr_sub.tier == 'legacy' %} (Legacy){% endif %}</div>
      {% else %}
        <button class="upgrade-tier-cta upgrade-tier-cta--monthly" onclick="handleUpgrade('monthly')">
          Get Pro Monthly
        </button>
      {% endif %}
    </div>

    <!-- Annual tier -->
    <div class="upgrade-tier upgrade-tier--annual">
      <div class="upgrade-tier-badge">⭐ BEST VALUE</div>
      <div class="upgrade-tier-name">Pro Annual</div>
      <div class="upgrade-tier-price">£34.99</div>
      <div class="upgrade-tier-period">per year <span style="color:#00ff88;font-size:0.75rem;">(~£2.92/mo)</span></div>
      <ul class="upgrade-features">
        <li class="upgrade-feature">✅ 1,200 scans/month</li>
        <li class="upgrade-feature">✅ Everything in Monthly</li>
        <li class="upgrade-feature">✅ AI deep grade (20/month)</li>
        <li class="upgrade-feature">✅ Save ~27% vs monthly</li>
      </ul>
      {% if ssr_is_premium and ssr_sub and ssr_sub.tier == 'annual' %}
        <div class="upgrade-tier-cta upgrade-tier-cta--free">✓ Current Plan</div>
      {% else %}
        <button class="upgrade-tier-cta upgrade-tier-cta--annual" onclick="handleUpgrade('annual')">
          Get Pro Annual
        </button>
      {% endif %}
      <div style="text-align:center;font-size:0.72rem;color:#9b95b8;margin-top:8px;">Save ~27% vs monthly</div>
    </div>

    <!-- Founder Yearly tier -->
    <div class="upgrade-tier upgrade-tier--founder" id="founderCard">
      <div class="upgrade-tier-badge upgrade-tier-badge--gold" id="founderBadge">⚡ LIMITED — FIRST 100</div>
      <div class="upgrade-tier-name">Founder Yearly</div>
      <div class="upgrade-tier-price">£19.99</div>
      <div class="upgrade-tier-period">per year (~£1.67/mo)</div>
      <ul class="upgrade-features">
        <li class="upgrade-feature">✅ Everything in Annual</li>
        <li class="upgrade-feature">✅ Founder pricing locked in for life of subscription</li>
        <li class="upgrade-feature">✅ 40 deep grades per month</li>
        <li class="upgrade-feature">✅ All current and future Pro features</li>
      </ul>
      {% if ssr_is_premium and ssr_sub and ssr_sub.tier == 'founder_yearly' %}
        <div class="upgrade-tier-cta upgrade-tier-cta--current">✓ Current Plan</div>
      {% else %}
        <button type="button" class="upgrade-tier-cta upgrade-tier-cta--founder"
                id="founderButton"
                onclick="handleUpgrade('founder_yearly')">
          Become a Founder
        </button>
      {% endif %}
      <div class="upgrade-tier-footnote" id="founderFootnote">
        ⚡ <span id="founderSpotsRemaining">Limited spots</span> remaining
      </div>
    </div>

  </div>

  <div class="upgrade-fair-usage-notice">
    <p>
      Fair usage limits apply to all Pro subscriptions.
      <a href="/terms#fair-usage" class="upgrade-fair-usage-link">Read our Fair Usage Policy</a>.
    </p>
  </div>

  <!-- Access code entry -->
  <div class="upgrade-code-section">
    <div style="color:#9b95b8;font-size:0.85rem;margin-bottom:12px;">Already have an access code?</div>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
      <input id="upgradeCodeInput" type="text"
             placeholder="GRAIL-XXXX-XXXX"
             autocomplete="off" autocapitalize="characters" spellcheck="false"
             style="padding:10px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.06);color:#f0ecff;font-size:0.9rem;font-family:monospace;outline:none;text-transform:uppercase;width:220px;"
             oninput="this.value=this.value.toUpperCase()">
      <button onclick="upgradeValidateCode()"
              style="padding:10px 18px;border-radius:8px;border:none;background:linear-gradient(135deg,#b14dff,#4d8eff);color:white;font-weight:700;font-size:0.85rem;cursor:pointer;">
        Unlock
      </button>
    </div>
    <div id="upgradeCodeError" style="display:none;color:#ff2d6f;font-size:0.78rem;margin-top:8px;text-align:center;">
      ❌ Invalid code. Please check and try again.
    </div>
    <div id="upgradeCodeSuccess" style="display:none;color:#00ff88;font-size:0.78rem;margin-top:8px;text-align:center;">
      ✅ Code accepted! Redirecting...
    </div>
  </div>
  <div class="upgrade-referral-section">
    <p class="upgrade-referral-title">🎁 Have a referral code?</p>
    <p class="upgrade-referral-desc">
      If a friend gave you a referral code, enter it below
      before clicking <strong>Get Pro Monthly</strong> to get
      your first month for <strong class="upgrade-referral-price">£2.99</strong>
      instead of £3.99.
    </p>
    <input type="text"
           id="referralCodeInput"
           placeholder="GRAIL-REF-XXXX-XXXX"
           class="upgrade-referral-input"
           oninput="this.value = this.value.toUpperCase()">
    <p class="upgrade-referral-note">
      ⚠️ Only applies to the monthly plan. Enter your code
      first, then click the button — the discount will show
      on the Stripe checkout page.
    </p>
  </div>
  <div class="upgrade-import-wrap">
    <a href="/collection" class="upgrade-import-link">
      📥 Already have a collection? Import it from CSV
    </a>
  </div>

  <!-- Coming soon notice -->

</div>

<style>
.upgrade-page { max-width: 1100px; margin: 0 auto; }

.upgrade-tiers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 32px;
}

.upgrade-tier {
    border-radius: 16px;
    padding: 24px 20px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
    display: flex;
    flex-direction: column;
    position: relative;
}

.upgrade-tier--monthly {
    border-color: rgba(177,77,255,0.3);
    background: rgba(177,77,255,0.05);
}
.upgrade-tier--annual {
    border-color: rgba(0,255,136,0.3);
    background: rgba(0,255,136,0.05);
}
.upgrade-tier--founder {
    border-color: rgba(255,215,0,0.3);
    background: rgba(255,215,0,0.05);
}

.upgrade-tier-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,255,136,0.2);
    border: 1px solid rgba(0,255,136,0.4);
    color: #00ff88;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
}
.upgrade-tier-badge--gold {
    background: rgba(255,215,0,0.2);
    border-color: rgba(255,215,0,0.4);
    color: #ffd700;
}

.upgrade-tier-name {
    font-family: 'Orbitron', monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--mi-muted,#aaa);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
    text-align: center;
}
.upgrade-tier-price {
    font-family: 'Orbitron', monospace;
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    background: linear-gradient(90deg, #ffd700, #ffe566);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}
.upgrade-tier-period {
    text-align: center;
    font-size: 0.75rem;
    color: var(--mi-muted,#aaa);
    margin-bottom: 20px;
}

.upgrade-features {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
    flex: 1;
}
.upgrade-feature {
    font-size: 0.8rem;
    color: var(--mi-text,#eee);
    padding: 5px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    gap: 6px;
}
.upgrade-feature:last-child { border-bottom: none; }
.upgrade-feature--no { color: var(--mi-muted,#aaa); }
.upgrade-feature--soon { color: var(--mi-muted,#aaa); }
.soon-badge {
    font-size: 0.6rem;
    background: rgba(177,77,255,0.2);
    color: #b14dff;
    padding: 1px 6px;
    border-radius: 4px;
    font-weight: 700;
}

.upgrade-tier-cta {
    display: block;
    width: 100%;
    padding: 10px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.85rem;
    text-align: center;
    cursor: pointer;
    border: none;
    transition: all 0.15s;
}
.upgrade-tier-cta--free {
    background: rgba(255,255,255,0.05);
    color: var(--mi-muted,#aaa);
    border: 1px solid rgba(255,255,255,0.1);
    cursor: default;
}
.upgrade-tier-cta--monthly {
    background: linear-gradient(135deg, #b14dff, #4d8eff);
    color: white;
}
.upgrade-tier-cta--monthly:hover { opacity: 0.85; transform: translateY(-1px); }
.upgrade-tier-cta--annual {
    background: linear-gradient(135deg, #00ff88, #00e5ff);
    color: #1a1830;
}
.upgrade-tier-cta--annual:hover { opacity: 0.85; transform: translateY(-1px); }
.upgrade-tier-cta--founder {
    background: linear-gradient(135deg, #ffd700, #ff8c00);
    color: #1a1830;
}
.upgrade-tier-cta--founder:hover { opacity: 0.85; transform: translateY(-1px); }

.upgrade-tier-cta--current {
    background: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.6);
    cursor: default;
    text-align: center;
    padding: 12px;
    border-radius: 8px;
}

.upgrade-tier-cta--sold-out {
    background: rgba(128,128,128,0.2);
    color: rgba(255,255,255,0.5);
    cursor: not-allowed;
    text-align: center;
    padding: 12px;
    border-radius: 8px;
}

.upgrade-tier--founder.is-sold-out {
    opacity: 0.6;
}

.upgrade-tier-footnote {
    font-size: 0.85em;
    color: rgba(255,215,0,0.9);
    margin-top: 12px;
    text-align: center;
}

.upgrade-fair-usage-notice {
    text-align: center;
    margin-top: 24px;
}
.upgrade-fair-usage-notice p {
    font-size: 0.9em;
    color: rgba(255,255,255,0.6);
}
.upgrade-fair-usage-link {
    color: rgba(255,215,0,0.9);
}

.upgrade-code-section {
    text-align: center;
    padding: 24px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    margin-bottom: 16px;
}
.upgrade-referral-section { margin-top: 16px; padding: 16px; background: rgba(177,77,255,0.06); border: 1px solid rgba(177,77,255,0.2); border-radius: 10px; max-width: 440px; margin-left: auto; margin-right: auto; }
.upgrade-referral-title { font-family: 'Orbitron', sans-serif; font-size: 0.85rem; font-weight: 700; color: #b14dff; margin-bottom: 6px; }
.upgrade-referral-desc { font-family: 'DM Sans', sans-serif; font-size: 0.82rem; color: rgba(255,255,255,0.65); line-height: 1.6; margin-bottom: 10px; }
.upgrade-referral-price { color: #00e5ff; }
.upgrade-referral-input { width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(177,77,255,0.3); border-radius: 8px; padding: 10px 14px; color: #fff; font-family: 'Orbitron', sans-serif; font-size: 0.82rem; letter-spacing: 0.05em; box-sizing: border-box; }
.upgrade-referral-note { font-family: 'DM Sans', sans-serif; font-size: 0.75rem; color: rgba(255,255,255,0.35); margin-top: 8px; line-height: 1.5; font-style: italic; }
.upgrade-import-wrap {
    text-align: center;
    margin-top: 16px;
}
.upgrade-import-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.45);
    text-decoration: none;
}
.upgrade-import-link:hover {
    color: #00e5ff;
}

@media (max-width: 900px) {
    .upgrade-tiers { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 500px) {
    .upgrade-tiers { grid-template-columns: 1fr; }
}
</style>

<script>
// Show scan limit warning if applicable
document.addEventListener('DOMContentLoaded', () => {
    if (typeof scanIsBlocked === 'function' && scanIsBlocked()) {
        document.getElementById('scanWarning').style.display = 'block';
    }
});

async function handleUpgrade(tier) {
    try {
        const refCode = (document.getElementById('referralCodeInput') || {}).value || '';
        const resp = await fetch('/api/create-checkout-session', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({tier, ref_code: refCode})
        });
        const data = await resp.json();
        if (data.url) {
            window.location.href = data.url;
        } else if (resp.status === 410 && data.error === 'sold_out') {
            showFounderSoldOut();
            alert(data.message || 'Founder Yearly is sold out.');
        } else {
            alert('Error: ' + (data.error || 'Could not create checkout session'));
        }
    } catch(e) {
        alert('Could not connect to payment system. Please try again.');
    }
}

async function upgradeValidateCode() {
    const input  = document.getElementById('upgradeCodeInput');
    const error  = document.getElementById('upgradeCodeError');
    const success= document.getElementById('upgradeCodeSuccess');
    const code   = input.value.trim().toUpperCase();
    if (!code) return;

    error.style.display   = 'none';
    success.style.display = 'none';

    try {
        const resp = await fetch('/api/validate_premium', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({code})
        });
        const data = await resp.json();
        if (data.valid) {
            localStorage.setItem('matchit_premium_v1', 'unlocked');
            localStorage.setItem('matchit_access_code_v1', code);
            localStorage.setItem('matchit_tier_v1', data.tier || 'monthly');
            document.cookie = 'gs_access_code=' + encodeURIComponent(code) + ';path=/;max-age=31536000;samesite=lax';
            // Sync collection from server on Pro unlock
            try {
                var _syncCode = code.trim().toUpperCase();
                var _syncResp = await fetch('/api/collection/sync?code=' + encodeURIComponent(_syncCode));
                if (_syncResp.ok) {
                    var _syncData = await _syncResp.json();
                    if (_syncData.items && _syncData.items.length > 0) {
                        var _local = JSON.parse(localStorage.getItem('matchit_collection_v1') || '[]');
                        var _server = _syncData.items;
                        var _seen = new Set(_local.map(function(x){ return x.sku; }));
                        _server.forEach(function(item){
                            if (!_seen.has(item.sku)) {
                                _local.push(item);
                                _seen.add(item.sku);
                            }
                        });
                        localStorage.setItem('matchit_collection_v1', JSON.stringify(_local));
                    }
                }
            } catch(_e) {}
            success.style.display = 'block';
            setTimeout(() => window.location.href = '/match', 1500);
        } else {
            if (data.reason && data.reason.indexOf('maximum number of devices') !== -1) {
                error.textContent = '❌ This code is already in use on too many devices. Contact support@grailsweep.com for help.';
            } else {
                error.textContent = '❌ ' + (data.reason || 'Invalid code. Please check and try again.');
            }
            error.style.display = 'block';
            input.style.borderColor = 'rgba(255,45,111,0.5)';
            setTimeout(() => { input.style.borderColor = ''; }, 2000);
        }
    } catch(e) {
        error.textContent = '❌ Could not verify. Check your connection.';
        error.style.display = 'block';
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('upgradeCodeInput');
    if (input) input.addEventListener('keydown', e => {
        if (e.key === 'Enter') upgradeValidateCode();
    });
});

async function loadFounderStatus() {
    const card      = document.getElementById('founderCard');
    const button    = document.getElementById('founderButton');
    const badge     = document.getElementById('founderBadge');
    const footnote  = document.getElementById('founderFootnote');
    const spotsSpan = document.getElementById('founderSpotsRemaining');

    if (!card) return; // founder card not on page (e.g. user already founder tier)

    try {
        const resp = await fetch('/api/founder-status');
        const data = await resp.json();

        if (data.sold_out) {
            showFounderSoldOut();
            return;
        }

        if (badge && spotsSpan && typeof data.remaining === 'number') {
            badge.textContent = `⚡ ${data.remaining} SPOTS LEFT`;
            spotsSpan.textContent = `${data.remaining} spots`;
        }
    } catch (e) {
        console.warn('Founder status check failed', e);
        // On error, leave card in default "Limited" state
    }
}

function showFounderSoldOut() {
    const card     = document.getElementById('founderCard');
    const button   = document.getElementById('founderButton');
    const badge    = document.getElementById('founderBadge');
    const footnote = document.getElementById('founderFootnote');

    if (!card) return;
    card.classList.add('is-sold-out');
    if (badge)    badge.textContent = '⚡ SOLD OUT';
    if (footnote) footnote.innerHTML = 'All 100 founder spots have been claimed.';
    if (button) {
        const soldOutDiv = document.createElement('div');
        soldOutDiv.className = 'upgrade-tier-cta upgrade-tier-cta--sold-out';
        soldOutDiv.textContent = 'Sold Out';
        button.parentNode.replaceChild(soldOutDiv, button);
    }
}

document.addEventListener('DOMContentLoaded', loadFounderStatus);
</script>
{% endblock %}