  <!-- Floating particle system -->
  <script>
  (function(){
    var canvas = document.getElementById('miParticleCanvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var W, H;
    var isMobile = window.innerWidth < 768;
    var COUNT = isMobile ? 15 : 42;
    if (COUNT === 0) return;
    var COLORS = ['rgba(177,77,255,','rgba(0,229,255,','rgba(0,255,136,','rgba(255,215,0,','rgba(255,45,111,'];

    function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
    resize();
    window.addEventListener('resize', resize);

    function makeParticle() {
      return {
        x: Math.random() * W,
        y: H + Math.random() * 60,
        size: Math.random() * 2.5 + 1,
        color: COLORS[Math.floor(Math.random() * COLORS.length)],
        vx: (Math.random() - 0.5) * 0.5,
        vy: -(Math.random() * 0.55 + 0.2),
        life: 0,
        maxLife: Math.random() * 300 + 140,
        isCard: Math.random() > 0.72
      };
    }

    var particles = [];
    for (var i = 0; i < COUNT; i++) {
      var p = makeParticle();
      p.y = Math.random() * H;
      p.life = Math.floor(Math.random() * p.maxLife);
      particles.push(p);
    }

    function loop() {
      ctx.clearRect(0, 0, W, H);
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        p.x += p.vx; p.y += p.vy; p.life++;
        var alpha = p.life < 40 ? (p.life / 40) * 0.65
          : p.life > p.maxLife - 40 ? ((p.maxLife - p.life) / 40) * 0.65 : 0.65;
        if (p.life > p.maxLife || p.y < -20) { particles[i] = makeParticle(); continue; }
        ctx.save();
        ctx.globalAlpha = alpha;
        if (p.isCard) {
          ctx.strokeStyle = p.color + '0.9)';
          ctx.lineWidth = 0.8;
          var w = p.size * 5, h = p.size * 7;
          ctx.strokeRect(p.x - w / 2, p.y - h / 2, w, h);
        } else {
          ctx.fillStyle = p.color + '1)';
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }
      requestAnimationFrame(loop);
    }
    loop();
  })();
  </script>
