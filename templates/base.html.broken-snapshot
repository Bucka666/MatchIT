(function bootstrapDeviceIdentity() {
    const KEY = 'matchit_device_id_v1';
    let deviceId = localStorage.getItem(KEY);
    if (!deviceId) {
        if (window.crypto && crypto.randomUUID) {
            deviceId = crypto.randomUUID();
        } else {
            deviceId = 'dev-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
        }
        localStorage.setItem(KEY, deviceId);
    }
    // Fire-and-forget — failure is non-blocking
    fetch('/api/identity/bootstrap', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({device_id: deviceId}),
        keepalive: true
    }).catch(() => {});
    window.MATCHIT_DEVICE_ID = deviceId;
})();
// ────────────────────────────────────────────────────────────────────────────
</script>
<script>
// ── Scan system: 30 free scans per calendar month ──────────────────────────
const FREE_TIER_MONTHLY_LIMIT = 30;

function _getCurrentPeriod() {
    const d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
}
function _getNextResetDate() {
    const d = new Date();
    d.setMonth(d.getMonth() + 1);
    d.setDate(1);
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
}
function scanGetState() {
    const currentPeriod = _getCurrentPeriod();
    let state;
    try { state = JSON.parse(localStorage.getItem('matchit_scans_v2') || 'null'); } catch(e) { state = null; }
    if (!state || state.period !== currentPeriod) {
        state = { count: 0, period: currentPeriod };
        localStorage.setItem('matchit_scans_v2', JSON.stringify(state));
    }
    return { count: state.count, period: state.period,
             remaining: Math.max(0, FREE_TIER_MONTHLY_LIMIT - state.count),
             limitReached: state.count >= FREE_TIER_MONTHLY_LIMIT };
}
function scanIncrement() {
    if (localStorage.getItem('matchit_premium_v1') === 'unlocked') return scanGetState();
    const s = scanGetState();
    const ns = { count: s.count + 1, period: s.period };
    localStorage.setItem('matchit_scans_v2', JSON.stringify(ns));
    return scanGetState();
}
function scanCanProceed() {
    if (localStorage.getItem('matchit_premium_v1') === 'unlocked') return true;
    return !scanGetState().limitReached;
}
// Legacy aliases (scanIsBlocked / scanGetCount / scanRemaining) kept for upgrade.html compatibility
function scanIsBlocked() { return !scanCanProceed(); }
function scanGetCount()  { return scanGetState().count; }
function scanRemaining() {
    if (localStorage.getItem('matchit_premium_v1') === 'unlocked') return 999999;
    return scanGetState().remaining;
}
// ────────────────────────────────────────────────────────────────────────────

async function gsInitPush() {
  if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
  if (localStorage.getItem('matchit_premium_v1') !== 'unlocked') return;
  var code = localStorage.getItem('matchit_access_code_v1');
  if (!code) return;
  try {
    var reg = await navigator.serviceWorker.ready;
    var existing = await reg.pushManager.getSubscription();
    if (existing) return; // already subscribed
    // Show enable button instead of auto-prompting
    var btn = document.getElementById('gsEnablePushBtn');
    if (btn) btn.style.display = 'inline-flex';
  } catch(e) {}
}

window.gsSubscribePush = async function() {
  var btn = document.getElementById('gsEnablePushBtn');
  if (btn) btn.style.display = 'none';
  try {
    var reg = await navigator.serviceWorker.ready;
    var permission = await Notification.requestPermission();
    if (permission !== 'granted') return;
    var vapidKey = '{{ cfg.get("vapid_public_key", "") }}';
    console.log('[PUSH] vapidKey length:', vapidKey.length, 'code:', localStorage.getItem('matchit_access_code_v1'), 'premium:', localStorage.getItem('matchit_premium_v1'));
    if (!vapidKey) return;
    var sub = await reg.pushManager.subscribe({
      userVisibleOnly: true,
      applicationServerKey: vapidKey
    });
    var code = localStorage.getItem('matchit_access_code_v1');
    await fetch('/api/push/subscribe', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({code: code.trim().toUpperCase(), subscription: sub.toJSON()})
    });
    if (btn) { btn.textContent = '✓ Notifications enabled'; btn.style.display = 'inline-flex'; btn.disabled = true; btn.style.background = 'rgba(0,255,136,0.15)'; btn.style.borderColor = 'rgba(0,255,136,0.4)'; btn.style.color = '#00ff88'; }
  } catch(e) { if (btn) btn.style.display = 'inline-flex'; }
}
function gsSyncCollection() {
    var code = localStorage.getItem('matchit_access_code_v1');
    if (!code || localStorage.getItem('matchit_premium_v1') !== 'unlocked') return;
    try {
        var items = JSON.parse(localStorage.getItem('matchit_collection_v1') || '[]');
        fetch('/api/collection/sync', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({code: code.trim().toUpperCase(), items: items})
        }).catch(function(){});
    } catch(_e) {}
}
function scanRemaining() {
    if (localStorage.getItem('matchit_premium_v1') === 'unlocked') return 999999;
    return Math.max(0, SCAN_LIMIT - scanGetCount());
}
</script>
