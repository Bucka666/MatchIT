<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{{ vbrand.page_title }}</title>
  <link rel="stylesheet" href="/static/style.css?v=3">
  <link rel="icon" type="image/x-icon" href="/static/assets/favicon.ico?v=2">
  <link rel="icon" type="image/png" href="/static/assets/grailsweep_favicon.png?v=2">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <!-- PWA -->
  <link rel="manifest" href="/static/manifest.json">
  <meta name="theme-color" content="#1a1830">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/static/assets/grailsweep_app_icon.png">

  <!-- ── Theme override: Lighter Purple ── -->
  <style>
    :root {
      --mi-bg: #1a1830;
      --mi-card: #252248;
      --mi-text: #f0ecff;
      --mi-muted: #9b95b8;
      --mi-accent: #b14dff;
      --mi-accent2: #00e5ff;
      --mi-gold: #ffd700;
      --mi-emerald: #00ff88;
      --mi-ruby: #ff2d6f;
      --mi-sapphire: #4d8eff;
    }

    html, body {
      overflow-x: hidden;
      max-width: 100vw;
    }

    body.mi-page {
      background: #1a1830;
      font-family: 'DM Sans', -apple-system, sans-serif;
      color: var(--mi-text);
    }

    /* ── Animated background ── */
    .mi-bg-canvas {
      position: fixed;
      inset: 0;
      z-index: -1;
      overflow: hidden;
      background: linear-gradient(135deg, #1a1830, #1e1a3a, #221e42);
    
    }
    .mi-bg-canvas::before {
      content: '';
      position: absolute;
      width: 200%;
      height: 200%;
      top: -50%;
      left: -50%;
      background:
        radial-gradient(ellipse at 25% 20%, rgba(177,77,255,0.25) 0%, transparent 50%),
        radial-gradient(ellipse at 75% 80%, rgba(0,229,255,0.2) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 50%, rgba(255,45,111,0.12) 0%, transparent 40%),
        radial-gradient(ellipse at 10% 90%, rgba(0,255,136,0.1) 0%, transparent 40%),
        radial-gradient(ellipse at 90% 10%, rgba(255,215,0,0.12) 0%, transparent 40%);
      animation: bgDrift 20s ease-in-out infinite alternate;
    }
    .mi-bg-canvas::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        repeating-linear-gradient(0deg, transparent, transparent 100px, rgba(255,255,255,0.015) 100px, rgba(255,255,255,0.015) 101px),
        repeating-linear-gradient(90deg, transparent, transparent 100px, rgba(255,255,255,0.015) 100px, rgba(255,255,255,0.015) 101px);
    }
    @keyframes bgDrift {
      0% { transform: translate(0,0) rotate(0deg); }
      100% { transform: translate(-3%,-2%) rotate(2deg); }
    }

    .mi-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      animation: orbFloat 15s ease-in-out infinite alternate;
    }
    .mi-orb-1 { width: 450px; height: 450px; background: #b14dff; top: -10%; left: -5%; opacity: 0.5; }
    .mi-orb-2 { width: 400px; height: 400px; background: #00e5ff; bottom: -10%; right: -5%; animation-delay: -5s; opacity: 0.5; }
    .mi-orb-3 { width: 350px; height: 350px; background: #ff2d6f; top: 40%; left: 60%; animation-delay: -10s; opacity: 0.3; }
    .mi-orb-4 { width: 300px; height: 300px; background: #00ff88; top: 60%; left: 10%; animation-delay: -7s; opacity: 0.25; }
    @keyframes orbFloat {
      0% { transform: translate(0,0) scale(1); }
      50% { transform: translate(30px,-20px) scale(1.1); }
      100% { transform: translate(-20px,30px) scale(0.95); }
    }

    /* Content above background */
    .mi-shell-main {
      position: relative;
      z-index: 1;
    }

    /* ── Global reset ── */
    html, body {
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      overflow-x: hidden !important;
      box-sizing: border-box !important;
    }
    .mi-shell {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 auto !important;
      padding: 0 !important;
      padding-top: env(safe-area-inset-top, 0px) !important;
      box-sizing: border-box !important;
      overflow-x: hidden !important;
    }

    /* ── Header restyle ── */
    .mi-top {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      background: rgba(30,28,55,0.7) !important;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,255,255,0.08) !important;
      padding: 1rem 1.5rem !important;
      padding-top: max(8px, env(safe-area-inset-top, 8px)) !important;
    }

    /* Gradient brand name */
    .mi-brand {
      justify-self: center;
    }
    .mi-brand-name {
      font-family: 'Orbitron', monospace !important;
      font-weight: 900 !important;
      background: linear-gradient(90deg, #b14dff, #00e5ff, #00ff88) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      background-clip: text !important;
      letter-spacing: 0.05em !important;
    }

    .mi-brand-sub {
      color: var(--mi-muted) !important;
      font-size: 0.7rem !important;
    }

    .mi-logo-wrap img {
      border-radius: 8px;
      box-shadow: 0 0 20px rgba(177,77,255,0.3);
    }

    /* ── Card/shell styling ── */
    .mi-card {
      background: rgba(37,34,72,0.95) !important;
      border: 1px solid rgba(255,255,255,0.08) !important;
      border-radius: 16px !important;
    }

    .mi-h1 {
      font-family: 'Orbitron', monospace !important;
      font-weight: 700 !important;
      letter-spacing: 0.05em !important;
      background: linear-gradient(90deg, #ffd700, #ffe566) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      background-clip: text !important;
    }

    .mi-pill-ghost {
      border-color: rgba(177,77,255,0.3) !important;
      color: #b14dff !important;
    }
    .mi-pill-ghost:hover {
      background: rgba(177,77,255,0.15) !important;
    }

    /* ── History link restyle ── */
    .mi-history-link {
      background: rgba(177,77,255,0.08) !important;
      border: 1px solid rgba(177,77,255,0.2) !important;
      color: #b14dff !important;
    }
    .mi-history-link:hover {
      background: rgba(177,77,255,0.2) !important;
      border-color: rgba(177,77,255,0.4) !important;
    }

    /* ── Header right area ── */
    .mi-top-right {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      flex-wrap: wrap;
      width: 100%;
    }
    .mi-back-btn, .mi-collection-nav, .mi-upgrade-nav, .nav-benefits-btn {
      font-size: clamp(0.6rem, 2vw, 0.78rem) !important;
      padding: clamp(4px, 1.5vw, 8px) clamp(6px, 2vw, 12px) !important;
      white-space: nowrap;
    }
    .mi-back-btn {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.05);
      color: var(--mi-muted, #aaa);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }
    .mi-back-btn:hover {
      background: rgba(177,77,255,0.15);
      border-color: rgba(177,77,255,0.3);
      color: #b14dff;
    }
    .mi-collection-nav {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(255,215,0,0.2);
      background: rgba(255,215,0,0.06);
      color: #ffd700;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.15s;
    }
    .mi-collection-nav:hover {
      background: rgba(255,215,0,0.15);
      border-color: rgba(255,215,0,0.4);
    }
    .mi-upgrade-nav {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(177,77,255,0.3);
      background: rgba(177,77,255,0.08);
      color: #b14dff;
      font-size: 0.8rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.15s;
    }
    .mi-upgrade-nav:hover {
      background: rgba(177,77,255,0.2);
      border-color: rgba(177,77,255,0.5);
    }

    .nav-benefits-btn {
      background: linear-gradient(90deg, #b14dff22, #00e5ff22);
      border: 1px solid #b14dff55;
      color: #b14dff;
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 0.75rem;
      font-family: 'DM Sans', sans-serif;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }
    .nav-benefits-btn:hover {
      background: linear-gradient(90deg, #b14dff44, #00e5ff44);
      border-color: #b14dff;
    }

    /* ── Search box layout + restyle ── */
    .mi-xr-form { display: flex; align-items: center; }
    .mi-xr-wrap {
      display: flex;
      align-items: center;
      border-radius: 8px;
      overflow: hidden;
      background: rgba(255,255,255,0.05) !important;
      border: 1px solid rgba(255,255,255,0.1) !important;
    }
    .mi-xr-wrap:focus-within {
      border-color: #00e5ff !important;
      box-shadow: 0 0 15px rgba(0,229,255,0.15);
    }
    .mi-xr-input {
      flex: 1;
      min-width: 160px;
      padding: 7px 10px;
      background: transparent;
      border: none;
      outline: none;
      color: #f0ecff;
      font-size: 0.82rem;
    }
    .mi-xr-input::placeholder { color: rgba(255,255,255,0.3); }
    .mi-xr-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 7px 10px;
      background: transparent;
      border: none;
      color: rgba(255,255,255,0.5);
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }
    .mi-xr-btn:hover {
      background: rgba(177,77,255,0.2) !important;
      color: #b14dff !important;
    }

    /* ── History link ── */
    .mi-history-link {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s;
    }

    /* ── Upload area ── */
    .mi-dropzone {
      border-color: rgba(177,77,255,0.3) !important;
      background: rgba(35,32,65,0.6) !important;
      transition: all 0.3s;
    }
    .mi-dropzone:hover, .mi-dropzone.drag {
      border-color: #b14dff !important;
      background: rgba(177,77,255,0.05) !important;
    }

    /* ── Buttons ── */
    .mi-btn:not(.mi-btn-ghost):not(.mi-btn-secondary), button[type="submit"].mi-btn {
      background: linear-gradient(135deg, #b14dff, #4d8eff, #00e5ff) !important;
      color: white !important;
      font-family: 'Orbitron', monospace !important;
      font-weight: 700 !important;
      letter-spacing: 0.06em !important;
      text-transform: uppercase !important;
      border: none !important;
      box-shadow: 0 4px 25px rgba(177,77,255,0.3) !important;
      position: relative;
      overflow: hidden;
      transition: all 0.3s !important;
    }
    .mi-btn:not(.mi-btn-ghost):not(.mi-btn-secondary):hover {
      box-shadow: 0 6px 35px rgba(177,77,255,0.5) !important;
      transform: translateY(-2px);
    }

    /* ── Flash messages ── */
    .mi-flash.ok {
      background: rgba(0,255,136,0.08) !important;
      border-color: rgba(0,255,136,0.2) !important;
      color: #00ff88 !important;
    }
    .mi-flash.err {
      background: rgba(255,45,111,0.08) !important;
      border-color: rgba(255,45,111,0.2) !important;
      color: #ff2d6f !important;
    }

    /* ── Footer ── */
    .gs-hidden { display: none !important; }
    .mi-footer-stat-num { color: #00e5ff; font-weight: 700; }
    .mi-footer-stats {
      font-family: 'DM Sans', sans-serif;
      font-size: 0.78rem;
      color: rgba(255,255,255,0.55);
      margin-bottom: 8px;
      padding: 6px 14px;
      background: rgba(0,229,255,0.06);
      border: 1px solid rgba(0,229,255,0.15);
      border-radius: 20px;
      display: inline-block;
    }
    .mi-footer {
      background: transparent !important;
      border-top: 1px solid rgba(255,255,255,0.06) !important;
      position: relative;
      z-index: 1;
    }
    .mi-footer div:first-child {
      color: var(--mi-muted) !important;
    }
    .mi-social-row {
      display: flex; flex-direction: column; align-items: center; gap: 10px;
      margin: 16px 0 4px;
    }
    .mi-social-label {
      font-family: 'DM Sans', sans-serif; font-size: 0.65rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.35);
    }
    .mi-social-links {
      display: flex; gap: 16px; align-items: center; flex-wrap: wrap; justify-content: center;
    }
    .mi-social-link {
      display: flex; align-items: center; gap: 7px;
      font-family: 'DM Sans', sans-serif; font-size: 0.78rem; font-weight: 600;
      color: rgba(255,255,255,0.45); text-decoration: none;
      transition: color 0.2s ease, transform 0.2s ease;
    }
    .mi-social-link:hover { color: #00e5ff; }
    .mi-social-link:hover svg { opacity: 1; }
    .mi-social-link svg { opacity: 0.5; transition: opacity 0.2s ease; flex-shrink: 0; }
    @media (prefers-reduced-motion: no-preference) {
      .mi-social-link:hover { transform: scale(1.05); }
    }

    /* ── Result card overrides (from results.html) ── */
    .res-card--top {
      border-color: rgba(255,215,0,0.3) !important;
      background: linear-gradient(135deg, rgba(255,215,0,0.05), rgba(177,77,255,0.04)) !important;
    }
    .res-card--mid {
      border-color: rgba(255,165,0,0.25) !important;
    }
    .res-card--low {
      border-color: rgba(255,45,111,0.2) !important;
    }
    .res-card--top .res-sku {
      background: linear-gradient(90deg, #ffd700, #ffe566) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      background-clip: text !important;
    }
    .res-card--top .res-rank-num { color: #ffd700 !important; }
    .res-card--mid .res-rank-num { color: #ff8c00 !important; }
    .res-card--low .res-rank-num { color: #ff2d6f !important; }

    /* Match strength bars */
    .res-conf-fill--high {
      background: linear-gradient(90deg, #00e5ff, #00ff88) !important;
    }
    .res-conf-fill--mid {
      background: linear-gradient(90deg, #ffd700, #ff8c00) !important;
    }
    .res-conf-fill--low {
      background: linear-gradient(90deg, #ff2d6f, #ff0040) !important;
    }
    .res-conf-val--high { color: #00ff88 !important; }
    .res-conf-val--mid { color: #ffd700 !important; }
    .res-conf-val--low { color: #ff2d6f !important; }

    .res-conf-lead--strong { background: rgba(0,255,136,0.1) !important; color: #00ff88 !important; }
    .res-conf-lead--moderate { background: rgba(0,229,255,0.1) !important; color: #00e5ff !important; }
    .res-conf-lead--slim { background: rgba(255,215,0,0.1) !important; color: #ffd700 !important; }

    /* Score bars */
    .res-card--top .res-barfill { background: #00ff88 !important; }
    .res-card--mid .res-barfill { background: #ffd700 !important; }
    .res-card--low .res-barfill { background: #ff2d6f !important; }

    /* Card name & set */
    .res-card-name {
      font-family: 'Orbitron', monospace !important;
      background: linear-gradient(90deg, #ffd700, #ffe566);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .res-card-set { color: #00e5ff !important; }

    /* Rarity tags — neon glow */
    .res-price-tag {
      color: #00ff88 !important;
      background: rgba(0,255,136,0.06) !important;
      border-color: rgba(0,255,136,0.15) !important;
    }

    /* Marketplace links */
    .res-mp-buy {
      color: #00ff88 !important;
      background: rgba(0,255,136,0.05) !important;
      border-color: rgba(0,255,136,0.15) !important;
    }
    .res-mp-buy:hover {
      background: rgba(0,255,136,0.15) !important;
      border-color: rgba(0,255,136,0.35) !important;
      box-shadow: 0 0 12px rgba(0,255,136,0.12);
    }
    .res-mp-sell {
      color: #ffd700 !important;
      background: rgba(255,215,0,0.05) !important;
      border-color: rgba(255,215,0,0.15) !important;
    }
    .res-mp-sell:hover {
      background: rgba(255,215,0,0.15) !important;
      border-color: rgba(255,215,0,0.35) !important;
      box-shadow: 0 0 12px rgba(255,215,0,0.12);
    }

    /* Cross-ref links */
    .res-xref-link {
      background: rgba(77,142,255,0.05) !important;
      border-color: rgba(77,142,255,0.15) !important;
      color: #4d8eff !important;
    }
    .res-xref-link:hover {
      background: rgba(77,142,255,0.15) !important;
      box-shadow: 0 0 10px rgba(77,142,255,0.12);
    }

    /* Thumbnails — #1 gets floating glow */
    .res-card--top .res-thumb,
    .res-card--top .res-thumb--ras {
      border-color: rgba(255,215,0,0.4) !important;
      animation: topCardFloat 4s ease-in-out infinite, topCardShimmer 6s ease-in-out infinite;
    }
    @keyframes topCardFloat {
      0%, 100% { transform: translateY(0); box-shadow: 0 0 20px rgba(255,215,0,0.15), 0 0 40px rgba(177,77,255,0.08); }
      50% { transform: translateY(-5px); box-shadow: 0 10px 35px rgba(255,215,0,0.3), 0 0 60px rgba(177,77,255,0.15); }
    }
    @keyframes topCardShimmer {
      0%, 100% { border-color: rgba(255,215,0,0.4); }
      33% { border-color: rgba(177,77,255,0.4); }
      66% { border-color: rgba(0,229,255,0.4); }
    }

    /* Desktop hover for other cards */
    @media (hover: hover) {
      .res-card:not(.res-card--top) .res-thumb:hover {
        transform: scale(1.08);
        box-shadow: 0 8px 30px rgba(0,0,0,0.3), 0 0 25px rgba(177,77,255,0.2);
        border-color: rgba(177,77,255,0.4) !important;
      }
    }

    /* Feedback bar */
    .res-feedback, .res-fb-followup {
      background: rgba(37,34,72,0.95) !important;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top-color: rgba(177,77,255,0.2) !important;
    }
    .res-fb-yes {
      background: rgba(0,255,136,0.15) !important;
      color: #00ff88 !important;
      border-color: rgba(0,255,136,0.3) !important;
    }
    .res-fb-no {
      background: rgba(255,45,111,0.1) !important;
      color: #ff2d6f !important;
      border-color: rgba(255,45,111,0.2) !important;
    }
    .res-fb-pick {
      background: rgba(255,255,255,0.04) !important;
      border-color: rgba(255,255,255,0.1) !important;
    }
    .res-fb-pick:hover {
      background: rgba(177,77,255,0.15) !important;
      border-color: rgba(177,77,255,0.3) !important;
    }


    /* Lightbox */
    .mi-lightbox {
      background: rgba(26,24,48,0.95) !important;
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
      z-index: 99999 !important;
    }
    
    .mi-lightbox img {
      box-shadow: 0 0 80px rgba(177,77,255,0.25), 0 0 40px rgba(0,229,255,0.15) !important;
    }

    /* Section titles */
    .res-section-title {
      color: #9b95b8 !important;
    }
    .res-xref-title {
      color: #9b95b8 !important;
    }

    /* Guidance box */
    .res-guidance {
      background: rgba(177,77,255,0.06) !important;
      border-color: rgba(177,77,255,0.15) !important;
    }
    .res-guidance-feedback {
      color: #00e5ff !important;
    }

    .res-feedback, .res-fb-followup, .res-fb-thanks {
      position: fixed !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      z-index: 999 !important;
    }

    /* ── Floating card silhouettes ── */
    .mi-float-card {
      position: fixed;
      border-radius: 8px;
      border: 1px solid;
      pointer-events: none;
      z-index: 0;
      animation: miCardDrift linear infinite;
    }
